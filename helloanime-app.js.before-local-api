/* ===== MENU SLIDER ===== */
try { (function() {
    const menuTrack = document.getElementById('menuTrack');
    if(!menuTrack) return;
    const buttons = menuTrack.querySelectorAll('.menu-button');
    const prevButton = document.getElementById('prevButton');
    const nextButton = document.getElementById('nextButton');
    const progressDots = document.getElementById('progressDots');
    let currentPosition = 0;
    let buttonsPerView = calculateButtonsPerView();
    let maxPosition = Math.max(0, buttons.length - buttonsPerView);
    let autoScrollInterval = null;
    let intervalPaused = false;
    let activeIndex = 0;
    function calculateButtonsPerView() {
        const containerWidth = menuTrack.parentElement.clientWidth;
        const buttonWidth = buttons[0] ? buttons[0].offsetWidth + 10 : 150;
        return Math.max(1, Math.floor((containerWidth - 100) / buttonWidth));
    }
    function createProgressDots() {
        progressDots.innerHTML = '';
        const numDots = Math.ceil(buttons.length / buttonsPerView);
        for (let i = 0; i < numDots; i++) {
            const dot = document.createElement('div');
            dot.classList.add('dot');
            if (i === 0) dot.classList.add('active');
            progressDots.appendChild(dot);
            dot.addEventListener('click', () => {
                pauseInterval();
                goToPosition(i);
                resumeInterval();
            });
        }
    }
    function goToPosition(position) {
        currentPosition = Math.min(maxPosition, Math.max(0, position));
        updateSliderPosition();
        updateActiveDot();
        updateNavButtons();
    }
    function updateSliderPosition() {
        const buttonWidth = buttons[0] ? buttons[0].offsetWidth + 10 : 150;
        menuTrack.style.transform = `translateX(-${currentPosition * buttonWidth}px)`;
    }
    function updateActiveDot() {
        const dots = progressDots.querySelectorAll('.dot');
        dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === currentPosition);
        });
    }
    function updateNavButtons() {
        prevButton.style.opacity = currentPosition === 0 ? '0.3' : '1';
        prevButton.style.pointerEvents = currentPosition === 0 ? 'none' : 'auto';
        nextButton.style.opacity = currentPosition >= maxPosition ? '0.3' : '1';
        nextButton.style.pointerEvents = currentPosition >= maxPosition ? 'none' : 'auto';
    }
    function setActiveButton(index) {
        buttons.forEach((btn, i) => {
            btn.classList.toggle('active', i === index);
        });
        activeIndex = index;
    }
    function startAutoScroll() {
        if (autoScrollInterval) clearInterval(autoScrollInterval);
        autoScrollInterval = setInterval(() => {
            if (!intervalPaused) {
                // Auto change active button
                activeIndex = (activeIndex + 1) % buttons.length;
                setActiveButton(activeIndex);
                // Auto scroll position
                if (currentPosition >= maxPosition) {
                    currentPosition = 0;
                } else {
                    currentPosition++;
                }
                updateSliderPosition();
                updateActiveDot();
                updateNavButtons();
            }
        }, 4500);
    }
    function pauseInterval() {
        intervalPaused = true;
    }
    function resumeInterval() {
        setTimeout(() => { intervalPaused = false; }, 3000);
    }
    // Button click to set active
    buttons.forEach((button, index) => {
        button.addEventListener('click', (e) => {
            setActiveButton(index);
        });
    });
    prevButton.addEventListener('click', () => {
        pauseInterval();
        goToPosition(currentPosition - 1);
        resumeInterval();
    });
    nextButton.addEventListener('click', () => {
        pauseInterval();
        goToPosition(currentPosition + 1);
        resumeInterval();
    });
    let touchStartX = 0, touchEndX = 0, touchStartY = 0, touchEndY = 0;
    menuTrack.parentElement.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
        pauseInterval();
    }, { passive: true });
    menuTrack.parentElement.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        const swipeThreshold = 50;
        if (Math.abs(touchEndY - touchStartY) < 100) {
            if (touchEndX + swipeThreshold < touchStartX) goToPosition(currentPosition + 1);
            else if (touchEndX > touchStartX + swipeThreshold) goToPosition(currentPosition - 1);
        }
        resumeInterval();
    }, { passive: true });
    menuTrack.parentElement.addEventListener('mouseenter', pauseInterval);
    menuTrack.parentElement.addEventListener('mouseleave', resumeInterval);
    function initialize() {
        createProgressDots();
        updateSliderPosition();
        updateNavButtons();
        startAutoScroll();
        setTimeout(() => {
            buttons.forEach((button, index) => {
                button.style.animationDelay = `${index * 0.08}s`;
                button.style.animation = 'slideIn 0.6s ease forwards';
            });
        }, 100);
        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                buttonsPerView = calculateButtonsPerView();
                maxPosition = Math.max(0, buttons.length - buttonsPerView);
                if (currentPosition > maxPosition) currentPosition = maxPosition;
                updateSliderPosition();
                createProgressDots();
                updateActiveDot();
                updateNavButtons();
            }, 200);
        });
    }
    initialize();
})(); } catch(e) { console.error("[Menu Slider]", e); }

