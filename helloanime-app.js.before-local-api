        let filtered = [];
        if(mode === 'genre') {
            filtered = items.filter(i => i.genres && i.genres.includes(criteria));
        } else if(mode === 'keyword') {
            filtered = items.filter(i => i.keywords && i.keywords.some(k => k.toLowerCase() === criteria));
        } else if(mode === 'language') {
            filtered = items.filter(item => {
                if(criteria === 'ORG')      return item.lang === 'ORG';
                if(criteria === 'FanDub')   return item.lang === 'FanDub' || item.lang === 'Fandub';
                if(criteria === 'HindiSub') return item.lang.includes('Hindi') && item.lang.includes('Sub');
                if(criteria === 'EngSub')   return item.lang.includes('Eng') && item.lang.includes('Sub');
                if(criteria === 'EngDub')   return item.lang.includes('Eng') && item.lang.includes('Dub');
                return false;
            });
        }

        const resContainer = document.getElementById(containerId);
        resContainer.innerHTML = '';
        filtered.forEach(item => {
