    window.filterData = function(btn, criteria, mode) {
        let items = window.groupedItemsGlobal;
        let containerId = mode === 'genre' ? 'genre-results' : (mode === 'keyword' ? 'keyword-results' : 'lang-results');
        let tabId       = mode === 'genre' ? 'genre-tabs'    : (mode === 'keyword' ? 'keyword-tabs'    : 'lang-tabs');

        document.querySelectorAll(`#${tabId} .genre-pill`).forEach(p => p.classList.remove('active'));
