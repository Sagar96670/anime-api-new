/* ===== STANDALONE ROUTER: page-links (/search/label, /search, /p) -> ?label= / ?q= on this single page ===== */
document.addEventListener('click', function (e) {
  var a = e.target && e.target.closest ? e.target.closest('a') : null;
  if (!a) return;
  var href = a.getAttribute('href') || '';
  if (!href) return;
  if (href.indexOf('/search/label/') === 0) {
    var label = decodeURIComponent(href.split('/search/label/')[1]);
    e.preventDefault();
    window.location.search = 'label=' + encodeURIComponent(label);
  } else if (href.indexOf('/p/') === 0) {
    var sp = new URLSearchParams(href.split('?')[1] || '');
    if (sp.get('language')) {
      e.preventDefault();
      window.location.search = 'label=' + encodeURIComponent(sp.get('language'));
    } else {
      e.preventDefault();
      window.location.replace('./'); 
    }
  } else if (href.indexOf('/search') === 0) {
    var sp2 = new URLSearchParams(href.split('?')[1] || '');
    if (sp2.get('q')) {
      e.preventDefault();
      window.location.search = 'q=' + encodeURIComponent(sp2.get('q'));
    }
  }
});

/* ===== HEADER NAV DROPDOWN MENU ===== */
try { (function() {
    function ready(fn) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
        else fn();
    }

    ready(function() {
        const menu = document.getElementById('menu');
        const toggle = document.getElementById('navMenuToggle');
        const panel  = document.getElementById('navMenuPanel');
        if(!menu || !toggle || !panel) return;

        function openMenu()  { menu.classList.add('open');  toggle.setAttribute('aria-expanded', 'true'); }
        function closeMenu() { menu.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }
        function isOpen()    { return menu.classList.contains('open'); }

        toggle.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            isOpen() ? closeMenu() : openMenu();
        });

        const closeBtn = document.getElementById('navMenuClose');
        if(closeBtn) closeBtn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation(); closeMenu();
        });

        document.addEventListener('click', function(e) {
            if(isOpen() && !menu.contains(e.target)) closeMenu();
        });
        document.addEventListener('keydown', function(e) {
            if(e.key === 'Escape' && isOpen()) closeMenu();
        });

        const SECTION_IDS = { genre: 'genre-section', language: 'lang-section', updated: 'blakite-main-grid' };

        function scrollToSection(name) {
            if(name === 'home') { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
            const id = SECTION_IDS[name];
            if(!id) return;
            let tries = 0;
            (function attempt() {
                const el = document.getElementById(id);
                if(el) {
                    const y = el.getBoundingClientRect().top + window.pageYOffset - 80;
                    window.scrollTo({ top: y < 0 ? 0 : y, behavior: 'smooth' });
                    return;
                }
                if(tries++ < 40) setTimeout(attempt, 150);
            })();
        }

        const onHome = !!document.getElementById('blakite-category-sliders');

        panel.querySelectorAll('.nav-menu-link').forEach(function(link) {
            link.addEventListener('click', function(e) {
                const action = link.getAttribute('data-menu-action');
                if(!action) { closeMenu(); return; }
                e.preventDefault();
                closeMenu();
                if(action === 'home') {
                    if(onHome) scrollToSection('home');
                    else window.location.href = '/';
                    return;
                }
                if(onHome) scrollToSection(action);
                else window.location.href = '/?section=' + action;
            });
        });

        const params = new URLSearchParams(window.location.search);
        const pending = params.get('section');
        if(pending && onHome) {
            const url = new URL(window.location.href);
            url.searchParams.delete('section');
            window.history.replaceState({}, '', url.pathname + url.search + url.hash);
            setTimeout(function() { scrollToSection(pending); }, 350);
        }
    });
})(); } catch(e) { console.error("[Nav Menu]", e); }

