        if(rawData) {
            buildCategories(rawData);
            renderAZList(rawData);
        } else {
            const container = document.getElementById('blakite-category-sliders');
            if(container) container.innerHTML = '<div style="color:#fff; text-align:center; padding: 50px;">Failed to load category data.</div>';
        }
        if(window.hideSitePreloader) setTimeout(window.hideSitePreloader, 50);
    }

    // --- first letter of the FIRST WORD of a title ---
    function firstWordLetter(title) {
        const word = String(title || '').trim().split(/\s+/)[0] || '';
        return word.charAt(0).toUpperCase();
    }

    // --- A-Z LIST: dynamically show only letters present in the anime titles ---
    function renderAZList(data) {
        const ul = document.querySelector('.azlist ul');
        if(!ul) return;
        const firstChars = new Set();
        ['movies', 'series', 'dramas'].forEach(key => {
            if(data[key]) Object.values(data[key]).forEach(item => {
                if(item && item.title) firstChars.add(firstWordLetter(item.title));
            });
        });
        const letters = [];
        if([...firstChars].some(c => !/[A-Z]/.test(c))) letters.push('#');
        'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(c => { if(firstChars.has(c)) letters.push(c); });
        ul.innerHTML = letters.map(c => `<li><a href='/ongoing.html?label=${encodeURIComponent(c)}'>${c}</a></li>`).join('');
    }

    function buildCategories(data) {
        let allItems = [];

        // Movies
        if(data.movies) {
            Object.entries(data.movies).forEach(([key, m]) => {
                allItems.push(formatCatItem(m, 'Movie', null, key));
            });
        }

        // Series
        if(data.series) {
            Object.entries(data.series).forEach(([key, s]) => {
                if(s.seasons && Object.keys(s.seasons).length > 0) {
                    Object.values(s.seasons).forEach(sea => {
                        allItems.push(formatCatItem(s, 'Series', sea, key));
                    });
                } else {
                    allItems.push(formatCatItem(s, 'Series', null, key));
                }
            });
        }

        // Dramas
        if(data.dramas) {
            Object.entries(data.dramas).forEach(([key, d]) => {
                if(d.seasons) {
                    Object.values(d.seasons).forEach(sea => {
                        allItems.push(formatCatItem(d, 'Drama', sea, key));
                    });
                } else {
                    allItems.push(formatCatItem(d, 'Drama', null, key));
                }
            });
        }

        allItems.sort((a, b) => b.date - a.date);

        const container = document.getElementById('blakite-category-sliders');
        if(!container) return;
        container.innerHTML = '';

        const groupedItems = groupSeries(allItems);

        // Genre/Keyword/Language tab filters ke liye global pool (hamesha set karo)
        window.groupedItemsGlobal = allItems;

        // 1. ONGOING
        const ongoing = allItems.filter(i => i.status === 'Ongoing');
        createRow(container, "Ongoing Anime", ongoing.slice(0, 20), "/ongoing.html", "play");

        // 2. CONTINUE WATCHING
        renderContinueWatching(container);

        // 3. MOVIES
        const movies = allItems.filter(i => i.type === 'Movie');
        createRow(container, "Movies Collection", movies.slice(0, 20), "/movie.html", "film");

        // 4. LANGUAGE
        renderLanguageSection(container, groupedItems);

        // 5. DRAMA & SERIES
        const drama = groupedItems.filter(i => i.type === 'Drama');
        if(drama.length > 0) createRow(container, "Drama & Live Action", drama.slice(0, 20), "/search/label/Drama", "masks");

        // 6. GENRE
        renderGenreSection(container, groupedItems);

        // 7. KEYWORDS
        renderKeywordSection(container, groupedItems);
    }

    // *** SMART GROUPING ***
    function groupSeries(items) {
        let groups = {};
        let final = [];

        items.forEach(item => {
            if(item.type !== 'Series') { final.push(item); return; }
            let cleanName = item.title.replace(/\(.*\)/g, '').replace(/Season\s+\d+/i, '').replace(/\s*-\s*Season\s*\d+/i, '').trim();
            let sMatch = item.title.match(/Season\s+(\d+)/i);
            let sNum = sMatch ? parseInt(sMatch[1]) : 1;
            if(!groups[cleanName]) groups[cleanName] = [];
            groups[cleanName].push({ item: item, sNum: sNum });
        });

        Object.keys(groups).forEach(name => {
            let list = groups[name];
            if(list.length === 1) {
                final.push(list[0].item);
            } else {
                list.sort((a, b) => a.sNum - b.sNum);
                let min = list[0].sNum;
                let max = list[list.length - 1].sNum;
                let latest = list[list.length - 1].item;
                let combo = { ...latest };
                combo.title = `${name} (Season ${min}-${max})`;
                combo.eps = `S${min}-S${max}`;
                combo.isGrouped = true;
                combo.link = `${BLAKITE_CFG.searchBase}?q=${encodeURIComponent(name)}`;
                final.push(combo);
            }
        });

        return final.sort((a, b) => b.date - a.date);
    }

    function formatCatItem(source, type, seasonObj, uniqueKey) {
        let title = source.title || "Unknown";

        let img = '';
        if(source.IMAGES) {
            img = source.IMAGES.poster || source.IMAGES.backdrop || BLAKITE_CFG.defaultImg || '';
        } else {
            img = BLAKITE_CFG.defaultImg || '';
        }

        let baseUrl = window.location.origin;
        let link = `${baseUrl}${BLAKITE_CFG.watchBase}?type=${type}&id=${uniqueKey}`;
        let badge = type === 'Series' ? 'Series' : (type === 'Drama' ? 'Drama' : 'Movie');
        let eps   = type === 'Drama' ? 'Drama' : 'Movie';
        let status = (seasonObj && seasonObj.status) ? seasonObj.status : (source.status ? source.status : 'Ongoing');

        let genres = [];
        if(source.TMDB_DATA && source.TMDB_DATA.genres) {
            source.TMDB_DATA.genres.forEach(g => {
                if(g.includes('&')) g.split('&').forEach(sub => genres.push(sub.trim()));
                else genres.push(g);
            });
        }

        let keywords = (source.TMDB_DATA && source.TMDB_DATA.keywords) ? source.TMDB_DATA.keywords : [];

        if((type === 'Series' || type === 'Drama') && seasonObj) {
            title = `${source.title} Season ${seasonObj.seasonNumber}`;
            link += `&s=${seasonObj.seasonNumber}&ep=1`;
            badge = `S${seasonObj.seasonNumber}`;

            const count = seasonObj.totalEpisodes || 0;
            eps = `S${seasonObj.seasonNumber}-EP${count}`;

            if(source.seasons && source.seasons[seasonObj.seasonNumber + 1]) {
                status = "Completed";
            }
        }

        if(type === 'Movie') status = 'Released';

        if(!seasonObj && source.anikoto && source.anikoto.epsCount) {
            eps = 'EP' + source.anikoto.epsCount;
        }

        let tsRaw = source.updatedAt
                 || source.createdAt
                 || (seasonObj && seasonObj.updatedAt)
                 || (seasonObj && seasonObj.createdAt)
                 || (source.TMDB_DATA && source.TMDB_DATA.releaseDate)
                 || null;
        let date = tsRaw ? new Date(tsRaw).getTime() : 0;
        if(isNaN(date)) date = 0;

        return { title, img, link, type, badge, eps, lang: source.language || 'Unknown', status, date, genres, keywords };
    }

