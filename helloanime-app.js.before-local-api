(function() {
    var btn = document.getElementById('randomBtn');
    if(!btn) return;
    btn.addEventListener('click', async function() {
        if(btn.dataset.loading) return;
        btn.dataset.loading = '1';
        try {
            var data = await getMainData();
            if(!data) throw new Error('No data');
            var pool = [];
            [['movies', 'Movie'], ['series', 'Series'], ['dramas', 'Drama']].forEach(function(pair) {
                if(data[pair[0]]) Object.keys(data[pair[0]]).forEach(function(key) { pool.push({ type: pair[1], id: key }); });
            });
            if(pool.length === 0) { delete btn.dataset.loading; return; }
            var pick = pool[Math.floor(Math.random() * pool.length)];
            var link = window.location.origin + BLAKITE_CFG.watchBase + '?type=' + encodeURIComponent(pick.type) + '&id=' + encodeURIComponent(pick.id);
            window.location.href = link;
        } catch(e) {
            console.error('[Random] failed:', e);
            delete btn.dataset.loading;
        }
    });
})();

/* ===== HIN/ENG SITE MODE TOGGLE + ANIKOTO API (Eng Mode) =====
   Hin mode = Blakite API (existing), Eng mode = Anikoto API (anikotoapi.site)
   + MegaPlay embeds. Eng mode data ko Blakite-shaped `{series}` me normalize
   karke existing renderers (grid, hero, sliders, search, random) reuse karta hai. */
function isEng() {
    return (localStorage.getItem('site_lang') || 'hindi') === 'english';
}

const ANIKOTO_CFG = {
    apiUrl: "/anikoto/",
    defaultImg: BLAKITE_CFG.defaultImg,
    allKey: "anikoto_all_v2",
    cacheTtl: 60 * 60 * 1000
};

const AnikotoAPI = (function() {
    // NOTE: recent-anime pages ab server-side cache hone lagte hain
    // (/anikoto/all -> server download + cache/ folder, 1 hr TTL). Client bhi
    // merged data ka 1hr localStorage cache rakhta hai (Hindi ke blakite_v7_
    // categories jaisa), taaki har page-load pe dobara download na ho.
    let allItemsCache = null;
    let allPromise = null;

    async function fetchJson(url) {
        const res = await fetch(url);
        if(!res.ok) throw new Error('Anikoto HTTP ' + res.status);
        return res.json();
    }

    function readLocalCache() {
        try {
            const o = JSON.parse(localStorage.getItem(ANIKOTO_CFG.allKey) || 'null');
            if(o && Date.now() - o.ts < ANIKOTO_CFG.cacheTtl) return o.value;
        } catch(e) {}
        return null;
    }

    function writeLocalCache(value) {
        try { localStorage.setItem(ANIKOTO_CFG.allKey, JSON.stringify({ ts: Date.now(), value: value })); } catch(e) {}
    }

    async function ensurePages(thru) {
        if(!allItemsCache) {
            if(!allPromise) {
                allPromise = loadAllFromServer().finally(function() { allPromise = null; });
            }
            await allPromise;
        }
        return allItemsCache ? [1] : [];
    }

    async function loadAllFromServer() {
        // Pehle client cache try karo (fast, Hindi jaisa), fir real /anikoto/all
        const cached = readLocalCache();
        if(cached) {
            allItemsCache = cached;
            return;
        }
        let json = null;
        for(let attempt = 0; attempt < 4; attempt++) {
            try {
                json = await fetchJson(ANIKOTO_CFG.apiUrl + 'all');
                break;
            } catch(e) {
                if(attempt === 3) throw e;
                await new Promise(r => setTimeout(r, 1500 * Math.pow(2, attempt)));
            }
        }
        const items = (json && Array.isArray(json.data)) ? json.data : [];
        let seq = 0;
        allItemsCache = items.map(function(raw) { return { seq: seq++, raw: raw }; });
        writeLocalCache(allItemsCache);
    }

    async function prefetchAll() {
        return ensurePages(1);
    }

    function allItems() {
        return allItemsCache || [];
    }

    function pagination() {
        return {
            loadedPages: allItemsCache ? [1] : [],
            totalPages: 1
        };
    }

    function normStatus(raw) {
        const s = String(raw || '').toLowerCase();
        if(!s) return 'Ongoing';
        if(s.indexOf('airing') !== -1) return 'Ongoing';
        if(s.indexOf('not yet') !== -1) return 'Not Yet Aired';
        return 'Completed';
    }

    function proxySeries(item, seq) {
        const id = String(item.id);
        const subCount = Number(item.is_sub || 0);
        const dubCount = Number(item.is_dub || 0);
        let lang;
        if(subCount > 0 && dubCount > 0) lang = 'SUB+DUB';
        else if(subCount > 0) lang = 'SUB';
        else if(dubCount > 0) lang = 'DUB';
        else lang = 'ENG';

        const genres = [];
        if(item.terms_by_type && Array.isArray(item.terms_by_type.genre)) {
            item.terms_by_type.genre.forEach(function(g) {
                String(g || '').split('&').forEach(function(x) {
                    x = x.trim();
                    if(x) genres.push(x);
                });
            });
        }

        // recency: page 1 (seq 0) sabse recent, sorting consistent rahe
        const fakeTs = Date.now() - seq * 60000;

        return {
            id: id,
            title: item.title || 'Unknown',
            status: normStatus(item.status),
            language: lang,
            updatedAt: new Date(fakeTs).toISOString(),
            IMAGES: {
                poster: item.poster || ANIKOTO_CFG.defaultImg,
                backdrop: item.background_image || item.poster || ANIKOTO_CFG.defaultImg
            },
            TMDB_DATA: {
                genres: genres,
                keywords: [],
                synopsis: item.description || '',
                rating: String(item.score || item.rating || '')
            },
            anikoto: {
                id: id,
                subCount: subCount,
                dubCount: dubCount,
                epsCount: Number(item.episodes || 0),
                statusRaw: item.status || '',
                year: item.year || '',
                season: item.season || ''
            }
        };
    }

    function getData() {
        const out = { series: {} };
        allItems().forEach(o => {
            if(o.raw && o.raw.id) out.series[String(o.raw.id)] = proxySeries(o.raw, o.seq);
        });
        return out;
    }

    async function getSeries(id) {
        const json = await fetchJson(ANIKOTO_CFG.apiUrl + 'series/' + encodeURIComponent(id));
        const payload = (json && json.data) ? json.data : null;
        if(!payload) throw new Error('Empty Anikoto series');
        return payload;
    }

    return { ensurePages, prefetchAll, allItems, getData, getSeries, pagination };
})();

async function getMainData() {
    if(isEng()) {
        await AnikotoAPI.ensurePages(1);
        AnikotoAPI.prefetchAll().then(function() {
            try {
                if(typeof processAndFilter === 'function') {
                    const after = AnikotoAPI.pagination().loadedPages.length;
                    if(after > 1) processAndFilter(AnikotoAPI.getData(), window.gridPage || 1);
                }
            } catch(e) { console.error('[Anikoto] prefetch refresh failed:', e); }
        });
        return AnikotoAPI.getData();
    }
    return await BlakiteAPI.getData();
}

window.ENG_LOAD_MORE = async function() {
    // Sab data ab server-side cache se ek saath /anikoto/all me milta hai,
    // isliye load-more sirf current grid ko re-render karta hai.
    const pager = document.getElementById('blakite-custom-pagination');
    if(!pager || !isEng()) return;
    if(typeof processAndFilter === 'function') {
        processAndFilter(AnikotoAPI.getData(), gridPage);
    }
};

(function() {
    function applyLang() {
        const cur = isEng() ? 'english' : 'hindi';
        document.querySelectorAll('#langToggle .lang-opt').forEach(function(o) {
            o.classList.toggle('active', (o.getAttribute('data-lang') || '') === cur);
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applyLang);
    else applyLang();

    document.addEventListener('click', function(e) {
        const opt = e.target && e.target.closest ? e.target.closest('#langToggle .lang-opt') : null;
        if(!opt) return;
        const target = opt.getAttribute('data-lang');
        if(!target) return;
        const cur = isEng() ? 'english' : 'hindi';
        if(target !== cur) {
            localStorage.setItem('site_lang', target);
            window.location.reload();
        }
    });
})();
