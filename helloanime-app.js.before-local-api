/* ===== RECENTLY UPDATED GRID + PAGINATION ===== */
  // API config aur caching logic global script se handle hoga
  const GRID_PER_PAGE = 24;

  let gridData = [];
  let gridPage = 1;
  let pageAlphabetBase = [];
  let selectedPageLanguage = 'ORG';

  function firstWordLetter(title) {
      const firstWord = String(title || '').trim().split(/\s+/)[0] || '';
      return firstWord.charAt(0).toUpperCase();
  }

  async function initMainGrid() {
      // Seedha global function call kar rahe hain
      const rawData = await getMainData();

      if (rawData) {
          processAndFilter(rawData);
      } else {
          const container = document.getElementById('blakite-main-grid');
          if(container) container.innerHTML = "<div style='text-align:center;padding:100px;color:#BF953F;font-weight:bold;'>Failed to load Anime data!</div>";
      }
      if(window.hideSitePreloader) setTimeout(window.hideSitePreloader, 50);
  }

  function formatItem(source, type, seasonObj, uniqueId) {
      let title = source.title || "Unknown";

      let img = '';
      if(source.IMAGES) {
          // Global default image bhi fallback ke liye add kar diya hai
          img = source.IMAGES.poster || source.IMAGES.backdrop || BLAKITE_CFG.defaultImg || '';
      }

      let tsRaw = source.updatedAt
               || source.createdAt
               || (seasonObj && seasonObj.updatedAt)
               || (seasonObj && seasonObj.createdAt)
               || (source.TMDB_DATA && source.TMDB_DATA.releaseDate)
               || null;
      let dateToUse = tsRaw ? new Date(tsRaw).getTime() : 0;
      if(isNaN(dateToUse)) dateToUse = 0;

      let baseUrl = window.location.origin;
      // Yahan BLAKITE_CFG.watchBase use kiya hai
      let link = `${baseUrl}${BLAKITE_CFG.watchBase}?type=${type}&id=${uniqueId}`;
      let eps = (source.anikoto && source.anikoto.epsCount) ? 'EP' + source.anikoto.epsCount : type;
      let status = (seasonObj && seasonObj.status) ? seasonObj.status : (source.status || 'Ongoing');

      if(type !== 'Movie' && seasonObj) {
          title = `${source.title} Season ${seasonObj.seasonNumber}`;
          link += `&s=${seasonObj.seasonNumber}&ep=1`;
          const epCount = seasonObj.totalEpisodes || 0;
          eps = `S${seasonObj.seasonNumber}-EP${epCount}`;
      } else if(type === 'Movie') {
          status = 'Released';
      }

      return {
          title, img, link, type, eps, status,
          date: dateToUse,
          lang: source.language || "",
          genres:   (source.TMDB_DATA && source.TMDB_DATA.genres)   ? source.TMDB_DATA.genres   : [],
          keywords: (source.TMDB_DATA && source.TMDB_DATA.keywords) ? source.TMDB_DATA.keywords : []
      };
  }

  // ===== FUZZY SEARCH ENGINE =====
  // Levenshtein distance - do words kitne alag hain
  function levenshtein(a, b) {
      const m = a.length, n = b.length;
      const dp = [];
      for(let i = 0; i <= m; i++) {
          dp[i] = [i];
          for(let j = 1; j <= n; j++) {
              dp[i][j] = i === 0 ? j :
                  a[i-1] === b[j-1] ? dp[i-1][j-1] :
                  1 + Math.min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1]);
          }
      }
      return dp[m][n];
  }

  // Ek query word ko ek text string ke against score karo
  function scoreWord(queryWord, targetText) {
      const target = targetText.toLowerCase();
      const query  = queryWord.toLowerCase();
      if(!target || !query) return 0;

      if(target === query)          return 100;
      if(target.includes(query))    return 80;

      const words = target.split(/\s+/);
      let best = 0;
      for(let w of words) {
          if(w === query)            { best = Math.max(best, 90);  continue; }
          if(w.startsWith(query))    { best = Math.max(best, 75);  continue; }
          if(w.includes(query))      { best = Math.max(best, 60);  continue; }
          // Fuzzy: short words 1 typo allow, long words 2 typos
          const maxDist = query.length <= 4 ? 1 : 2;
          if(levenshtein(query, w) <= maxDist) { best = Math.max(best, 50); }
      }
      return best;
  }

  // Puri query ko item ke against score karo
  function scoreItem(item, queryWords) {
      let totalScore  = 0;
      let matchedWords = 0;
      const validWords = queryWords.filter(w => w.length >= 2);

      validWords.forEach(qw => {
          let best = 0;
          // Title - 2x weight (sabse important)
          best = Math.max(best, scoreWord(qw, item.title) * 2);
          // Genres
          item.genres.forEach(g   => { best = Math.max(best, scoreWord(qw, g)); });
          // Keywords - 0.8x weight
          item.keywords.forEach(k => { best = Math.max(best, scoreWord(qw, k) * 0.8); });
          // Language - 0.5x weight
          best = Math.max(best, scoreWord(qw, item.lang) * 0.5);

          if(best > 0) matchedWords++;
          totalScore += best;
      });

      if(matchedWords === 0) return 0;

      // Zyada words match hon to bonus score
      const matchRatio = matchedWords / validWords.length;
      return totalScore * matchRatio;
  }

  function processAndFilter(data, keepPage) {
      let list = [];

      if(data.movies) {
          Object.entries(data.movies).forEach(([k, v]) => {
              list.push(formatItem(v, 'Movie', null, k));
          });
      }
      if(data.series) {
          Object.entries(data.series).forEach(([k, v]) => {
              if(v.seasons && Object.keys(v.seasons).length > 0) {
                  Object.keys(v.seasons).sort((a, b) => Number(a) - Number(b)).forEach(sKey => {
                      list.push(formatItem(v, 'Series', v.seasons[sKey], k));
                  });
              } else {
                  list.push(formatItem(v, 'Series', null, k));
              }
          });
      }
      if(data.dramas) {
          Object.entries(data.dramas).forEach(([k, v]) => {
              if(v.seasons && Object.keys(v.seasons).length > 0) {
                  Object.keys(v.seasons).sort((a, b) => Number(a) - Number(b)).forEach(sKey => {
                      list.push(formatItem(v, 'Drama', v.seasons[sKey], k));
                  });
              } else {
                  list.push(formatItem(v, 'Drama', null, k));
              }
          });
      }

      const path   = window.location.pathname;
      const params = new URLSearchParams(window.location.search);
      const searchQuery = params.get('q');
      const languageParam = params.get('language');
      const labelParam  = params.get('label') || (window.PAGE_FORCE_LABEL || '');
      const labelPath   = path.includes('/search/label/') ? path : (labelParam ? '/search/label/' + labelParam : '');
      const forcedLabel = (window.PAGE_FORCE_LABEL || '').toLowerCase();
      const pageFilterType = (window.PAGE_FILTER_TYPE || '').toLowerCase();
      const pageFilterStatus = (window.PAGE_FILTER_STATUS || '').toLowerCase();
      let pageTitle = "Recently Updated";

      // ===== DEDICATED LANGUAGE PAGE (language.html) =====
      if(window.PAGE_LANGUAGE_PAGE) {
          list.sort((a, b) => b.date - a.date);
          pageAlphabetBase = list.slice();
          const code = (languageParam && LANGUAGE_LABELS[languageParam]) ? languageParam : selectedPageLanguage;
          renderPageLanguageFilters(pageAlphabetBase, code);
          selectedPageLanguage = code;
          gridData = pageAlphabetBase.filter(item => languageMatches(item.lang, code));
          if(languageParam && LANGUAGE_LABELS[languageParam]) {
              pageTitle = 'Language: ' + (LANGUAGE_LABELS[languageParam] || languageParam);
          } else {
              pageTitle = window.PAGE_TITLE || 'Browse by Language';
          }
          const titleEl = document.getElementById('page-title');
          if(titleEl) titleEl.innerText = pageTitle;
          renderGridPage(1);
          return;
      }

      // Ongoing and Movies use the same first-letter filtering pattern as
      // the home page's genre/language pills, but keep their own data scope.
      if(pageFilterType) {
          list = list.filter(item => {
              if(item.type.toLowerCase() !== pageFilterType) return false;
              if(!pageFilterStatus) return true;
              const status = item.status.toLowerCase();
              return status === pageFilterStatus || (pageFilterStatus === 'ongoing' && status === 'airing');
          });
          pageAlphabetBase = list.slice();
          const pLetter = labelPath.includes('/search/label/') ? decodeURIComponent(labelPath.split('/search/label/')[1]).split('?')[0] : '';
          const activeLetter = (pLetter.length === 1) ? (pLetter === '#' ? '#' : pLetter.toUpperCase()) : '';
          if(!searchQuery) renderPageAlphabetFilters(pageAlphabetBase, activeLetter);
      } else {
          pageAlphabetBase = [];
          const alphabetFilters = document.getElementById('page-alphabet-filters');
          if(alphabetFilters) alphabetFilters.innerHTML = '';
      }

      // ===== q= SEARCH LOGIC =====
      if(searchQuery && searchQuery.trim().length > 0) {
          const cleanQuery = searchQuery.replace(/\+/g, ' ').trim();
          pageTitle = `Search Results: ${cleanQuery}`;

          const queryWords = cleanQuery.toLowerCase().split(/\s+/).filter(w => w.length >= 2);

          if(queryWords.length > 0) {
              let scored = list.map(item => ({
                  ...item,
                  _score: scoreItem(item, queryWords)
              })).filter(item => item._score > 0);

              scored.sort((a, b) => b._score - a._score);
              list = scored;
          } else {
              list = [];
          }
      }
      // ===== LABEL FILTER LOGIC =====
      else if(labelPath.includes('/search/label/')) {
          let label = decodeURIComponent(labelPath.split('/search/label/')[1]).split('?')[0].replace(/\+/g, ' ');
          const L = label.toLowerCase().trim();
          pageTitle = `Category: ${label}`;

          list = list.filter(item => {
              const forcedType = pageFilterType || (['movie', 'series', 'drama'].includes(forcedLabel) ? forcedLabel : '');
              if(forcedType && item.type.toLowerCase() !== forcedType) return false;

              if(label.length === 1) {
                  const firstChar = firstWordLetter(item.title);
                  if(label === '#') return !/[A-Z]/.test(firstChar);
                  return firstChar === label.toUpperCase();
              }

              const itemLang   = item.lang.toLowerCase();
              const itemType   = item.type.toLowerCase();
              const itemStatus = item.status.toLowerCase();

              if(L === 'english dubbed'   || L === 'engdub')   return itemLang.includes('eng') && itemLang.includes('dub');
              if(L === 'english subbed'   || L === 'engsub')   return itemLang.includes('eng') && itemLang.includes('sub');
              if(L === 'hindi subbed'     || L === 'hindisub') return itemLang.includes('hindi') && itemLang.includes('sub');
              if(L === 'hindi dubbed org' || L === 'org')      return itemLang === 'org' || (itemLang.includes('hindi') && itemLang.includes('org'));
              if(L === 'hindi fan dubbed' || L === 'fandub')   return itemLang.includes('fandub');

              if(L === 'movie'  || L === 'movies') return itemType === 'movie';
              if(L === 'series')                   return itemType === 'series';
              if(L === 'drama')                    return itemType === 'drama';

              if(L === 'ongoing')   return itemStatus === 'ongoing'   || itemStatus === 'airing';
              if(L === 'completed') return itemStatus === 'completed' || itemStatus === 'finished';

              return item.genres.some(g => g.toLowerCase().trim() === L);
          });

          list.sort((a, b) => b.date - a.date);
      }
      // ===== LANGUAGE FILTER (?language=) =====
      else if(languageParam) {
          const label = LANGUAGE_LABELS[languageParam] || languageParam;
          pageTitle = `Language: ${label}`;
          list = list.filter(item => languageMatches(item.lang, languageParam));
          list.sort((a, b) => b.date - a.date);
      }
      // ===== DEFAULT: LATEST =====
      else {
          list.sort((a, b) => b.date - a.date);
      }

      if(window.PAGE_TITLE) pageTitle = window.PAGE_TITLE;

      const titleEl = document.getElementById('page-title');
      if(titleEl) titleEl.innerText = pageTitle;

      gridData = list;
      renderGridPage(keepPage || 1);
  }

  function renderPageAlphabetFilters(items, activeLetter) {
      const container = document.getElementById('page-alphabet-filters');
      if(!container) return;

      const available = new Set();
      items.forEach(item => {
          const letter = firstWordLetter(item.title);
          if(letter) available.add(letter);
      });

      const letters = [...available].sort((a, b) => a.localeCompare(b));
      const allClass = activeLetter ? '' : ' active';
      const buttons = ['<button type="button" class="page-filter-pill' + allClass + '" data-letter="all" onclick="filterPageByLetter(this, \'all\')">All <span>' + items.length + '</span></button>'];
      letters.forEach(letter => {
          const count = items.filter(item => firstWordLetter(item.title) === letter).length;
          const active = letter === activeLetter ? ' active' : '';
          buttons.push(`<button type="button" class="page-filter-pill${active}" data-letter="${letter}" onclick="filterPageByLetter(this, '${letter}')">${letter} <span>${count}</span></button>`);
      });

      container.innerHTML = `
          <div class="page-filter-heading">
              <span>Browse by Letter</span>
              <small>Title ke first word ke first letter se filter karein</small>
          </div>
          <div class="page-filter-scroller">${buttons.join('')}</div>`;
  }

  window.filterPageByLetter = function(button, letter) {
      document.querySelectorAll('#page-alphabet-filters .page-filter-pill').forEach(pill => pill.classList.remove('active'));
      button.classList.add('active');
      if(letter === 'all') {
          gridData = pageAlphabetBase.slice();
      } else {
          gridData = pageAlphabetBase.filter(item => firstWordLetter(item.title) === letter);
      }
      renderGridPage(1);
  };

  function renderPageLanguageFilters(items, activeCode) {
      const container = document.getElementById('page-language-filters');
      if(!container) return;

      const codes = ['ORG', 'FanDub', 'EngSub', 'EngDub', 'HindiSub'];
      const present = codes.filter(c => items.some(item => languageMatches(item.lang, c)));
      if(present.length === 0) return;
      if(!present.includes(activeCode)) activeCode = present[0];

      const buttons = present.map(c => {
          const count = items.filter(item => languageMatches(item.lang, c)).length;
          const active = c === activeCode ? ' active' : '';
          return `<button type="button" class="page-filter-pill${active}" data-lang="${c}" onclick="filterPageLanguage(this, '${c}')">${LANGUAGE_LABELS[c] || c} <span>${count}</span></button>`;
      });

      container.innerHTML = `
          <div class="page-filter-heading">
              <span>Browse by Language</span>
              <small>Select a language to view its anime</small>
          </div>
          <div class="page-filter-scroller">${buttons.join('')}</div>`;
  }

  window.filterPageLanguage = function(button, code) {
      document.querySelectorAll('#page-language-filters .page-filter-pill').forEach(pill => pill.classList.remove('active'));
      if(button) button.classList.add('active');
      selectedPageLanguage = code;
      gridData = pageAlphabetBase.filter(item => languageMatches(item.lang, code));
      const titleEl = document.getElementById('page-title');
      if(titleEl) titleEl.innerText = 'Language: ' + (LANGUAGE_LABELS[code] || code);
      renderGridPage(1);
  };

  function renderGridPage(page) {
      gridPage = page;
      const start = (page - 1) * GRID_PER_PAGE;
      const chunk = gridData.slice(start, start + GRID_PER_PAGE);
      const container = document.getElementById('blakite-main-grid');
      if(!container) return;

      if(gridData.length === 0) {
          container.innerHTML = "<div style='text-align:center;padding:100px;color:#BF953F;font-weight:bold;'>No Results Found!</div>";
          const pager = document.getElementById('blakite-custom-pagination');
          if(pager) pager.innerHTML = "";
          return;
      }

      let html = `<div class="premium-grid">`;
      chunk.forEach(item => {
          let stClass = (item.status === 'Completed' || item.status === 'Released') ? 'st-cmp' : 'st-ong';
          html += `<a href="${item.link}" class="p-card">
              <div class="p-poster">
                  <img src="${item.img}" loading="lazy">
                  <div class="p-status ${stClass}">${item.status}</div>
                  <div class="p-badges">
                      <span class="bg-ep">${item.eps}</span>
                      <span class="bg-lang">${item.lang}</span>
                  </div>
              </div>
              <div class="p-title">${item.title}</div>
          </a>`;
      });
      container.innerHTML = html + `</div>`;
      renderGridControls();
  }

  function renderGridControls() {
      const total = Math.ceil(gridData.length / GRID_PER_PAGE);
      const pager = document.getElementById('blakite-custom-pagination');
      if(!pager) return;
      const engPaging = isEng() && !!window.PAGE_API_PAGING;
      if(total <= 1 && !engPaging) { pager.innerHTML = ''; return; }
      let html = `<div class="custom-pager-container">`;
      if(gridPage > 1)     html += `<div class="custom-pager-btn" onclick="renderGridPage(${gridPage - 1})">PREV</div>`;
      let infoText = `Page ${gridPage} of ${total || 1}`;
      if(engPaging) {
const meta = AnikotoAPI.pagination();
         const cap = meta.totalPages || 1;
         const lastLoaded = meta.loadedPages.length > 0 ? meta.loadedPages[meta.loadedPages.length - 1] : 1;
         infoText += ` &middot; Anikoto ${lastLoaded}/${cap}`;
      }
      html += `<span class="pager-info">${infoText}</span>`;
      if(gridPage < total) {
          html += `<div class="custom-pager-btn" onclick="renderGridPage(${gridPage + 1})">NEXT</div>`;
      } else if(engPaging) {
          const meta = AnikotoAPI.pagination();
          const cap = meta.totalPages || 1;
          const lastLoaded = meta.loadedPages.length > 0 ? meta.loadedPages[meta.loadedPages.length - 1] : 1;
          if(lastLoaded < cap) html += `<div class="custom-pager-btn" onclick="ENG_LOAD_MORE()">NEXT</div>`;
      }
      pager.innerHTML = html + `</div>`;
  }

  document.addEventListener('DOMContentLoaded', initMainGrid);

