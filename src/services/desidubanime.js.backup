const axios = require("axios");
const cheerio = require("cheerio");

const BASE_URL = "https://www.desidubanime.me";

async function fetchPage(url) {
  const response = await axios.get(url, {
    timeout: 30000,
    headers: {
      "User-Agent": "Mozilla/5.0"
    }
  });

  return cheerio.load(response.data);
}

async function getAnimeList(page = 1) {
  const url = page === 1 ? `${BASE_URL}/anime/` : `${BASE_URL}/anime/page/${page}/`;
  const $ = await fetchPage(url);
  const anime = [];
  const seen = new Set();

  $("img[alt*='poster']").each((i, element) => {
    const img = $(element);
    const link = img.parent().find("a[href*='/watch/']").first();
    const watchUrl = link.attr("href");
    const title = img.attr("alt")?.replace(/\s+poster$/i, "");
    const slug = watchUrl?.match(/\/watch\/([^/]+)-episode-\d+/)?.[1];

    if (!watchUrl || !title || !slug || seen.has(slug)) return;
    seen.add(slug);
    anime.push({ id: slug, title: title.trim(), url: `${BASE_URL}/anime/${slug}/`, poster: img.attr("src") || null });
  });

  return anime;
}

async function getAnimeDetails(url) {
  const $ = await fetchPage(url);

  const title = $("meta[property='og:title']")
    .attr("content")
    ?.replace(/\s*-\s*Desi Dub Anime$/i, "")
    .trim() || $("h1").text().trim().split("\n").pop().trim();

  const wpId = $("body").attr("class")?.match(/postid-(\d+)/)?.[1] || null;
  const poster = $("img[src*='myanimelist']").first().attr("src") || null;
  const banner = $("img[data-src]").first().attr("data-src") || null;

  const episodes = [...new Set(
    $("a[href*='/watch/']")
      .map((i, e) => $(e).attr("href"))
      .get()
      .filter(Boolean)
      .map(url => new URL(url, BASE_URL).href)
  )];

  return { title, url, wp_id: wpId ? Number(wpId) : null, poster, banner, episodes };
}

module.exports.getAnimeDetails = getAnimeDetails;

async function getEpisodes(animeWpId) {
  const axios = require("axios");
  const allEpisodes = [];
  let maxPages = 1;

  for (let page = 1; page <= maxPages; page++) {
    const response = await axios.get(
      `${BASE_URL}/wp-admin/admin-ajax.php`,
      {
        params: {
          action: "get_episodes",
          anime_id: animeWpId,
          page,
          order: "desc"
        },
        headers: { "User-Agent": "Mozilla/5.0" },
        timeout: 30000
      }
    );

    if (!response.data.success) {
      throw new Error(`Episodes fetch failed on page ${page}`);
    }

    const data = response.data.data;
    maxPages = Number(data.max_episodes_page) || 1;
    allEpisodes.push(...data.episodes);

    console.log(`Episodes page ${page}/${maxPages}: ${data.episodes.length}`);
  }

  return [...new Map(allEpisodes.map(ep => [ep.id, ep])).values()];
}

module.exports.getEpisodes = getEpisodes;

module.exports.BASE_URL = BASE_URL;
module.exports.fetchPage = fetchPage;
module.exports.getAnimeList = getAnimeList;
module.exports.getAnimeDetails = getAnimeDetails;

async function getEpisodeEmbedUrl(episodeUrl) {
  const $ = await fetchPage(episodeUrl);

  const iframe = $("iframe[src]").map((i, el) => $(el).attr("src")).get()
    .find(src => src && src.includes("filesforever.link/embed/"));

  return iframe || null;
}

module.exports.getEpisodeEmbedUrl = getEpisodeEmbedUrl;
