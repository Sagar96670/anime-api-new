require("dotenv").config();

const express = require("express");
const desiDubAnime = require("./src/services/desidubanime");
const cors = require("cors");
const seasonStore = require("./src/storage/season-store");
const animeStore = require("./src/storage/anime-store");

const app = express();

app.use(cors());
app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    status: true,
    message: "Anime API is running",
    project: "anime-api-new"
  });
});

app.get("/api/health", (req, res) => {
  res.json({
    status: true,
    message: "Server is healthy",
    timestamp: new Date().toISOString()
  });
});

// Anime Catalog API
app.get("/api/anime", async (req, res) => {
  try {
    const anime = await animeStore.listAnime();
    res.json({
      status: true,
      total: anime.length,
      anime
    });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});

app.get("/api/anime/:animeId", async (req, res) => {
  try {
    const anime = await animeStore.getAnime(req.params.animeId);
    if (!anime) {
      return res.status(404).json({ status: false, message: "Anime not found" });
    }
    res.json({ status: true, anime });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});

app.get("/api/anime/:animeId/seasons", async (req, res) => {
  try {
    const animeId = req.params.animeId;
    const seasons = [];
    for (let season = 1; season <= 50; season++) {
      const data = await seasonStore.getSeasonEpisodes(animeId, season);
      if (data) seasons.push({ season, episode_count: (data.episodes || []).length });
    }
    res.json({ status: true, anime_id: animeId, total_seasons: seasons.length, seasons });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});


// Sync Anime Season Episodes
app.post("/api/anime/:animeId/sync/:season", async (req, res) => {
  try {
    const animeId = req.params.animeId;
    const season = Number(req.params.season);

    if (!Number.isInteger(season) || season < 1) {
      return res.status(400).json({ status: false, message: "Invalid season" });
    }

    const anime = await animeStore.getAnime(animeId);
    if (!anime) {
      return res.status(404).json({ status: false, message: "Anime not found" });
    }

    const details = await desiDubAnime.getAnimeDetails(anime.url);
    if (!details.wp_id) {
      return res.status(502).json({ status: false, message: "WordPress ID not found" });
    }

    await animeStore.saveAnime(animeId, { ...anime, wp_id: details.wp_id });

    const rawEpisodes = await desiDubAnime.getEpisodes(details.wp_id);
    const episodes = rawEpisodes
      .filter(ep => Number(ep.anime_season || 1) === season)
      .map(ep => ({
        id: String(ep.id),
        meta_number: Number(ep.meta_number || 0),
        title: ep.title || ep.post_title || ep.number,
        url: ep.url,
        thumbnail: ep.thumbnail || null,
        duration: ep.duration || null
      }));

    if (!episodes.length) {
      return res.status(404).json({ status: false, message: "No episodes found" });
    }

    await seasonStore.saveSeasonEpisodes(animeId, season, episodes);

    res.json({
      status: true,
      anime_id: animeId,
      season,
      synced: episodes.length,
      episodes
    });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});

// Generic Anime Season Episodes
app.get("/api/anime/:animeId/episodes", async (req, res) => {
  try {
    const animeId = req.params.animeId;
    const season = Number(req.query.season);
    const page = Math.max(1, Number(req.query.page) || 1);
    const limit = Math.min(100, Math.max(1, Number(req.query.limit) || 30));

    if (!Number.isInteger(season) || season < 1) {
      return res.status(400).json({
        status: false,
        message: "Valid season parameter is required"
      });
    }

    const data = await seasonStore.getSeasonEpisodes(animeId, season);

    if (!data) {
      return res.status(404).json({ status: false, message: "Season not found" });
    }

    const episodes = data.episodes || [];
    const start = (page - 1) * limit;

    res.json({
      status: true,
      anime_id: animeId,
      season,
      total_episodes: episodes.length,
      page,
      limit,
      total_pages: Math.ceil(episodes.length / limit),
      episodes: episodes.slice(start, start + limit)
    });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});

// Episode Embed Stream API
app.get("/api/anime/:animeId/episode/:episodeId/stream", async (req, res) => {
  try {
    const { animeId, episodeId } = req.params;
    let episode = null;
    let season = null;

    for (let n = 1; n <= 50; n++) {
      const data = await seasonStore.getSeasonEpisodes(animeId, n);
      const found = (data?.episodes || []).find(ep => String(ep.id) === episodeId);
      if (found) {
        episode = found;
        season = n;
        break;
      }
    }

    if (!episode) {
      return res.status(404).json({ status: false, message: "Episode not found" });
    }

    const embedUrl = await desiDubAnime.getEpisodeEmbedUrl(episode.url);
    if (!embedUrl) {
      return res.status(502).json({ status: false, message: "Embed URL not found" });
    }

    res.json({
      status: true,
      anime_id: animeId,
      season,
      episode_id: episodeId,
      episode: episode.title,
      type: "embed",
      embed_url: embedUrl,
      video_url: embedUrl
    });
  } catch (error) {
    res.status(500).json({ status: false, message: error.message });
  }
});

if (require.main === module) {
  const PORT = process.env.PORT || 3000;
  app.listen(PORT, () => console.log(`Anime API running on port ${PORT}`));
}

module.exports = app;
